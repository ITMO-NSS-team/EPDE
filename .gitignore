# --- Experiment output ---
# Thesis workspace holds analysis SCRIPTS; every table, panel and figure in it
# is generated, so track the .py and nothing else.
projects/thesis/*
!projects/thesis/*.py
projects/**/plots/
projects/pic/data/**/*_pinn_*.npz
projects/pic/data/**/_nnm_*.npz
projects/pic/data/dp/dp_fno.npz
*.prof
*.gif
